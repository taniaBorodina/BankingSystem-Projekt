<Window x:Class="NexusBank.Wpf.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusBank - Panel klienta"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="NEXUS BANK"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"/>

            <TextBlock x:Name="WelcomeText"
                       FontSize="18"
                       Margin="0,12,0,25"/>

            <TextBlock Text="Twoje konta"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

            <DataGrid x:Name="AccountsGrid"
                      Height="250"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numer konta"
                                        Binding="{Binding AccountNumber}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Saldo"
                                        Binding="{Binding Balance, StringFormat=F2}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Waluta"
                                        Binding="{Binding Currency}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Operacje na koncie -->
            <TextBlock Text="Operacje bankowe"
           FontSize="22"
           FontWeight="SemiBold"
           Margin="0,25,0,15"/>

            <StackPanel Orientation="Horizontal">

                <TextBox x:Name="AmountTextBox"
             Width="180"
             Height="40"
             FontSize="16"
             Padding="8"
             VerticalContentAlignment="Center"/>

                <Button Content="Wpłać"
            Width="120"
            Height="40"
            Margin="15,0,0,0"
            Background="#16A34A"
            Foreground="White"
            Click="DepositButton_Click"/>

                <Button Content="Wypłać"
            Width="120"
            Height="40"
            Margin="15,0,0,0"
            Background="#DC2626"
            Foreground="White"
            Click="WithdrawButton_Click"/>

            </StackPanel>


            <Button Content="Wyloguj się"
                    Width="140"
                    Height="40"
                    Margin="0,25,0,0"
                    HorizontalAlignment="Left"
                    Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

