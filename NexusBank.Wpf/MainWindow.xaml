<Window x:Class="NexusBank.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusBank - Logowanie"
        Height="560"
        Width="850"
        MinHeight="480"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid>
        <Border Width="390"
                Padding="35"
                Background="White"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="NEXUS BANK"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1D4ED8"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Twój bank w jednym miejscu"
                           FontSize="14"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,35"/>

                <TextBlock Text="Login"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="LoginTextBox"
                         Height="38"
                         FontSize="16"
                         Padding="8"/>

                <TextBlock Text="PIN"
                           FontWeight="SemiBold"
                           Margin="0,20,0,7"/>

                <PasswordBox x:Name="PinPasswordBox"
                             Height="38"
                             FontSize="16"
                             Padding="8"
                             MaxLength="4"/>

                <Button Content="ZALOGUJ SIĘ"
                        Height="45"
                        Margin="0,28,0,0"
                        Background="#1D4ED8"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

                <Button Content="Nie masz konta? Zarejestruj się"
        Height="40"
        Margin="0,12,0,0"
        Background="White"
        Foreground="#1D4ED8"
        BorderBrush="#1D4ED8"
        Cursor="Hand"
        Click="RegisterButton_Click"/>


                <TextBlock x:Name="MessageText"
                           Foreground="#DC2626"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>

                <TextBlock Text="NexusBank • Projekt edukacyjny"
                           Foreground="#94A3B8"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
